rule "IncCreationLogicMonitor_9:"
when
    $incidentRequest : IncidentCreationRequestDto(  issue.source == "4" && (issue.severity == "CRITICAL" || issue.severity == "MAJOR")  && issue.name matches "(?:.*Volume Capacity.*PercentUsed.*|.*MemoryUtilizationPercent.*|.*CPUBusyPercent.*)")
then
	System.out.println("IncCreationLogicMonitor_9 Short Decription = " +$incidentRequest.getIssue().getName());
	List<String> deviceNamesList=Arrays.asList("BWOBODSP1","BWOBOLUMP1","BWOBOP01","BWOBOP02","BWOBOWBP01","BWOBOWBP02");
	System.out.println("Host names for priority setting = " +deviceNamesList.toString());
	$incidentRequest.getPostMap().put("category","Infrastructure");
	$incidentRequest.getPostMap().put("subcategory","Other");
	$incidentRequest.getPostMap().put("u_x_business_model" , "corporate");
	$incidentRequest.getPostMap().put("u_region" , "EU");
	System.out.println("Incident Device Matched  = " + $incidentRequest.getIssue().getIssueResources().get(0).getResourceName());
	if(deviceNamesList.contains($incidentRequest.getIssue().getIssueResources().get(0).getResourceName())){
		$incidentRequest.getPostMap().put("impact", "1");
		$incidentRequest.getPostMap().put("urgency", "2");
	}else{
		$incidentRequest.getPostMap().put("impact", "2");
		$incidentRequest.getPostMap().put("urgency", "3");
	}
	$incidentRequest.getPostMap().put("assignment_group",getAssignmentGroup($incidentRequest.getIssue().getName()));
	$incidentRequest.getPostMap().put("short_description", $incidentRequest.getIssue().getName());
	$incidentRequest.getPostMap().put("description", $incidentRequest.getIssue().getDescription());
	$incidentRequest.getPostMap().put("cmdb_ci",$incidentRequest.getIssue().getIssueResources().get(0).getResourceName());
end