package com.infy.ceh.management.autonomics.tasks.impl; 

import com.infy.ceh.management.ems.dto.IPPIssue;
import com.infy.ceh.management.ems.dto.IPPIncident;
import com.infy.ceh.management.ems.dto.IncidentCreationRequestDto;
import java.lang.String;
import java.lang.Boolean;
import java.util.List;
import java.util.Arrays;

function java.lang.String getAssignmentGroup(String name) {
	System.out.println("Short Decription = " +name);
    if (name == null) return "ISM - EOC Monitoring";
    
	String groupName = "";
	
	if(name.contains("MAO Order Management")){
		groupName = "Asia WMS";
	}else if((name.contains("Netskope") || name.contains("NetSkope")) && (name.contains("Publisher") || name.contains("IPSEC Tunnel") || name.contains("GRE Tunnel"))){
		groupName = "ISM - Network";
	}else if(name.contains("Netskope") || name.contains("NetSkope")){
		groupName = "ISM - Security Netskope";
	}else{
		groupName = "ISM - EOC Monitoring";
	}
	System.out.println("Assignment group for INC creation is  = "+groupName);
    return groupName;
}

rule "IncCreationLogicMonitor_1:"
when
    $incidentRequest : IncidentCreationRequestDto(  issue.source == "4" && issue.severity == "CRITICAL" && (issue.name matches "^(?!.*vSphere Distributed Switch).*"))
then
	$incidentRequest.getPostMap().put("category","Infrastructure");
	$incidentRequest.getPostMap().put("subcategory","Other");
	$incidentRequest.getPostMap().put("u_x_business_model" , "corporate");
	$incidentRequest.getPostMap().put("u_region" , "EU");
	$incidentRequest.getPostMap().put("impact", "2");
	$incidentRequest.getPostMap().put("urgency", "2");
	$incidentRequest.getPostMap().put("assignment_group",getAssignmentGroup($incidentRequest.getIssue().getName()));
	$incidentRequest.getPostMap().put("short_description", $incidentRequest.getIssue().getName());
	$incidentRequest.getPostMap().put("description", $incidentRequest.getIssue().getDescription());
	$incidentRequest.getPostMap().put("cmdb_ci",$incidentRequest.getIssue().getIssueResources().get(0).getResourceName());
end

