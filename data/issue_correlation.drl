rule "AlertsCorrelation_default_3 :"
when
    // Host inserts a single List<IPPGroupedAlerts> fact with raw alerts
    $alertsRawList : List()

    $matchedAlertList : List() from collect(       
			IPPGroupedAlerts(sourceId == "LogicMonitor" && duration < 24 && alertName matches "(?:.*VMware Alerts.*connection and power state State|.*VMware vSphere ESXi Host Status.*|.*VMware Alerts.*Network uplink redundancy lost State|.*VMware Host Status.*SystemHealth)")  from $alertsRawList;		
    )

    // Optional: constrain the spread of durations to ensure temporal proximity
    accumulate(
        IPPGroupedAlerts($duration : duration) from $matchedAlertList;
        $min : min($duration), $max : max($duration);
        $max - $min < 24
    )
then
     System.out.println("Matched Alerts  = " + $matchedAlertList.size());
	String hostRegex = "(?<=VMware Alerts-).*?(?=\\/Host connection and power state State)|(?<=VMware vSphere ESXi Host Status-)(.*?)(?=\\s+Status)|(?<=VMware vSphere ESXi Host Status-)(.*?)(?=\\s+ConnectionState)|(?<=VMware Alerts-).*?(?=\\/Network uplink redundancy lost State)|(?<=VMware Host Status-)(.*?)(?=\\s+SystemHealth)";
	System.out.println("Regex to Matched Alerts  = " + hostRegex);
    java.util.Set affectedHosts = getAffectedHosts($matchedAlertList,hostRegex);
    for (Object key : affectedHosts) {
        String host = (String) key;
        java.util.List alerts = getAlertsforSameAffectedHosts(host, $matchedAlertList);
		System.out.println("Matched Alerts (Host 24h) = " + $matchedAlertList.size());
        if (alerts.size() > 1) {
            System.out.println("Cluster for host " + host + " size=" + alerts.size());
            clusteredAlerts.put(index, alerts);
            index++;
            kcontext.getKnowledgeRuntime().setGlobal("index", Integer.valueOf(index));

            // Prevent reprocessing downstream
            $alertsRawList.removeAll(alerts);
        }
		System.out.println("host "+host+"-" + $alertsRawList.size());
    }
end

rule "AlertsCorrelation_default_4 : "
when
    $alertsRawList : List()
    $matchedAlertList : List() from collect(       
			IPPGroupedAlerts(sourceId == "LogicMonitor" && duration < 24)  from $alertsRawList;		
    )

    // Optional: constrain the spread of durations to ensure temporal proximity
    accumulate(
        IPPGroupedAlerts($duration : duration) from $matchedAlertList;
        $min : min($duration), $max : max($duration);
        $max - $min < 24
    )
then
	java.util.Set affectedResourcesAlertKeys=getAffectedResourcesAlertKey($matchedAlertList);	
		  for(Object key : affectedResourcesAlertKeys){
			String resourceAlertKey=(String) key;
			java.util.List alerts= getAlertsForResourceAlertKey(resourceAlertKey, $matchedAlertList);
			if(alerts.size() > 1){
				System.out.println("Alerts for resourceAlertKey: "+ resourceAlertKey);
				clusteredAlerts.put(index,alerts);
				index++;
				kcontext.getKnowledgeRuntime().setGlobal( "index", Integer.valueOf(index));
				$alertsRawList.removeAll(alerts);
			}			
		}	
end

rule "AlertsCorrelation_default_5 :"
when
    // Host inserts a single List<IPPGroupedAlerts> fact with raw alerts
    $alertsRawList : List()

    $matchedAlertList : List() from collect(       
			IPPGroupedAlerts(sourceId == "LogicMonitor" && duration < 24 && alertName matches "(?:.*Interfaces.*StatusFlap)")  from $alertsRawList;		
    )

    // Optional: constrain the spread of durations to ensure temporal proximity
    accumulate(
        IPPGroupedAlerts($duration : duration) from $matchedAlertList;
        $min : min($duration), $max : max($duration);
        $max - $min < 24
    )
then
     
	System.out.println("Matched Alerts  = " + $matchedAlertList.size());
	 
	java.util.Set affResources = getAffectedResources($matchedAlertList);
	String interfacesRegex = "eth\\d+";
	System.out.println("Regex to Matched Alerts  = " + interfacesRegex);
    java.util.Set affectedInterfaces = getAffectedHosts($matchedAlertList,interfacesRegex);
    for (Object key : affResources) {
		String host = (String) key;
		for (Object key1 : affectedInterfaces) {
			String iname = (String) key1;
			java.util.List alerts = groupAlertsBasedonHostAndIntrfaces(iname,host ,$matchedAlertList);
			System.out.println("Matched Alerts (Host 24h) = " + $matchedAlertList.size());
			if (alerts.size() > 1) {
				System.out.println("Cluster for host " + host + " size=" + alerts.size());
				clusteredAlerts.put(index, alerts);
				index++;
				kcontext.getKnowledgeRuntime().setGlobal("index", Integer.valueOf(index));

				// Prevent reprocessing downstream
				$alertsRawList.removeAll(alerts);
			}
			System.out.println("host "+host+"-" + $alertsRawList.size());
		}
    }
end

rule "AlertsCorrelation_default_6 :"
when
    // Host inserts a single List<IPPGroupedAlerts> fact with raw alerts
    $alertsRawList : List()

    $matchedAlertList : List() from collect(       
			IPPGroupedAlerts(sourceId == "LogicMonitor" && duration < 24 && alertName matches "(?:.*Meraki Switch Interfaces_Critical-Port.*)")  from $alertsRawList;		
    )
    // Optional: constrain the spread of durations to ensure temporal proximity
    accumulate(
        IPPGroupedAlerts($duration : duration) from $matchedAlertList;
        $min : min($duration), $max : max($duration);
        $max - $min < 24
    )
then    
	System.out.println("Meraki Matched Alerts  = " + $matchedAlertList.size());
	java.util.Set affResources = getAffectedResources($matchedAlertList);
	System.out.println("affResources  = " + affResources);
    for (Object key : affResources) {
		String host = (String) key;
		java.util.Set affectedPort = getPortFromAlertName($matchedAlertList,host);
		System.out.println("host  = " + host);
		System.out.println("affectedPort  = " + affectedPort);
		for (Object key1 : affectedPort) {
			String port = (String) key1;
			java.util.List alerts = groupAlertsBasedonDeviceAndPort(host,port, $matchedAlertList);
			System.out.println("Matched Alerts (Host 24h) = " + $matchedAlertList.size());
			if (alerts.size() > 1) {
				System.out.println("Cluster for host " + host + " size=" + alerts.size());
				clusteredAlerts.put(index, alerts);
				index++;
				kcontext.getKnowledgeRuntime().setGlobal("index", Integer.valueOf(index));
				// Prevent reprocessing downstream
				$alertsRawList.removeAll(alerts);
			}
			System.out.println("host "+host+"-" + $alertsRawList.size());
		}
    }
end


rule "AlertsCorrelation_default_0 : Default correlation LMD"
when
    // Host inserts a single List<IPPGroupedAlerts> fact with raw alerts
    $alertsRawList : List()

    // Collect alerts that have an LMD ID in their description and are within 24h
    $matchedAlertList : List() from collect(       
			IPPGroupedAlerts(sourceId == "LogicMonitor" && duration < 24)  from $alertsRawList;		
    )

    // Optional: constrain the spread of durations to ensure temporal proximity
    accumulate(
        IPPGroupedAlerts($duration : duration) from $matchedAlertList;
        $min : min($duration), $max : max($duration);
        $max - $min < 24
    )
then
    System.out.println("Matched Alerts (LMD 24h) = " + $matchedAlertList.size());

    java.util.Set lmdIds = getLmdIds($matchedAlertList);
    for (Object key : lmdIds) {
        String lmdId = (String) key;
        java.util.List alerts = getAlertsForLmdId(lmdId, $matchedAlertList);
        if (alerts.size() > 1) {
            System.out.println("Cluster for LMD " + lmdId + " size=" + alerts.size());
            clusteredAlerts.put(index, alerts);
            index++;
            kcontext.getKnowledgeRuntime().setGlobal("index", Integer.valueOf(index));

            // Prevent reprocessing downstream
            $alertsRawList.removeAll(alerts);
        }
		System.out.println("lmdId "+lmdId+"-" + $alertsRawList.size());
    }
end